{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spaceplanner.local/schemas/layout.schema.json",
  "title": "SpacePlanner generated layout",
  "type": "object",
  "required": ["schemaVersion", "floorPlanId", "generatedAt", "mode", "zones", "placements", "corridors", "metrics", "report"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "floorPlanId": { "type": "string" },
    "generatedAt": { "type": "string" },
    "mode": { "type": "string", "pattern": "^(rule-based|llm:[a-z]+)$" },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "polygon"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "polygon": { "type": "array", "minItems": 3, "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } } },
          "seats": { "type": "integer", "minimum": 0 },
          "label": { "type": "string" }
        }
      }
    },
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "itemId", "zoneId", "position", "rotationDeg"],
        "properties": {
          "id": { "type": "string" },
          "itemId": { "type": "string" },
          "zoneId": { "type": "string" },
          "position": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
          "rotationDeg": { "type": "number" }
        }
      }
    },
    "corridors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["polygon", "width"],
        "properties": {
          "polygon": { "type": "array", "minItems": 3, "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } } },
          "width": { "type": "number", "minimum": 0 }
        }
      }
    },
    "metrics": { "type": "object" },
    "report": {
      "type": "object",
      "required": ["feasible", "warnings", "suggestions", "explanation"],
      "properties": {
        "feasible": { "type": "boolean" },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "suggestions": { "type": "array", "items": { "type": "string" } },
        "explanation": { "type": "string" }
      }
    }
  }
}
