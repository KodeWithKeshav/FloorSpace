{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spaceplanner.local/schemas/requirements.schema.json",
  "title": "SpacePlanner requirements",
  "type": "object",
  "required": ["schemaVersion", "zones"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string" },
    "floorPlanId": { "type": "string" },
    "projectName": { "type": "string", "maxLength": 120 },
    "expectedOutcome": { "enum": ["feasible", "infeasible"] },
    "expectedResponse": { "type": "string" },
    "freeTextEquivalent": { "type": "string" },
    "zones": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["workstation", "cabin", "meeting", "cafeteria", "reception", "phonebooth", "lounge", "storage", "pantry"] },
          "count": { "type": "integer", "minimum": 1, "maximum": 100 },
          "seats": { "type": "integer", "minimum": 1, "maximum": 2000 },
          "seatsEach": { "type": "integer", "minimum": 1, "maximum": 20 },
          "capacityEach": { "type": "integer", "minimum": 1, "maximum": 60 },
          "preferredStyle": { "type": "string" },
          "preference": { "enum": ["window", "core_adjacent", "entry_adjacent", "quiet", "none"] }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minAreaPerSeat": { "type": "number", "minimum": 1, "maximum": 20 },
        "targetUtilization": { "type": "number", "minimum": 0.3, "maximum": 0.95 },
        "accessibleRoutes": { "type": "boolean" }
      }
    }
  }
}
