# Backend port (the Vite dev server proxies /api to it)
PORT=3001

# LLM providers (used from Phase 4). Leave blank to run fully offline in rule-based mode.
# Keys stay on the server and are never sent to the browser.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional overrides: groq | gemini | openrouter, and a model name for that provider
LLM_PROVIDER=
LLM_MODEL=

# Plan-from-image uses a vision model. Order tried: LLM_PROVIDER (if set), then Gemini, OpenRouter, Groq.
# Optional model overrides (defaults shown):
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_MODEL=google/gemini-2.5-flash
# GROQ_MODEL=qwen/qwen3.8-27b
